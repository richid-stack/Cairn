{
  "name": "@cairn/ui",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Cairn design system components. Every component ships with every state and an accessibility test.",
  "exports": {
    ".": "./src/index.ts",
    "./ui.css": "./src/ui.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:visual": "pnpm build-storybook && playwright test",
    "test:visual:update": "pnpm build-storybook && playwright test --update-snapshots"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@cairn/tokens": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "lucide-react": "1.55.0"
  }
}
