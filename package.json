{
  "name": "cairn",
  "private": true,
  "version": "0.0.0",
  "description": "Cairn: a personal agent that asks before it acts",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "pnpm --filter @cairn/contract gen",
    "gen:check": "pnpm gen && git diff --exit-code -- packages/contract/src/generated",
    "verify": "pnpm gen:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.14.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
